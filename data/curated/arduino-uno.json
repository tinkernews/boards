  "gotchas": [
    {
      "title": "2 KB of RAM goes fast",
      "text": "String literals are copied into RAM unless they are kept in flash with PROGMEM or wrapped in F(); text-heavy sketches fill the 2 KB of SRAM long before the flash.",
      "source": "arduino-ref-progmem"
    },
    {
      "title": "Pins 0 and 1 are the USB serial",
      "text": "D0 and D1 carry the serial link to the computer; anything connected to them can interfere with Serial output and cause failed uploads.",
      "source": "arduino-ref-serial"
    },
    {
      "title": "5 V logic",
      "text": "I/O is 5 V. Sensors and modules that run at 3.3 V (most modern ones) need level shifting on their inputs.",
