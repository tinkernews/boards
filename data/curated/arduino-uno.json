  "revisions": [
    {
      "name": "R1",
      "released": "2010-09",
      "changes": "ATmega8U2 as the USB-to-serial converter in place of the FTDI chip of earlier boards.",
      "source": "arduino-blog-2010"
    },
    {
      "name": "R2",
      "changes": "Added a resistor pulling the ATmega8U2's HWB line to ground, making it easier to put the USB chip into DFU mode.",
      "source": "arduino-hc-uno"
    },
    {
      "name": "R3",
      "changes": "The 1.0 pinout: SDA and SCL pins beside AREF, IOREF and a spare pin beside RESET; a stronger reset circuit; the ATmega16U2 replaces the 8U2.",
      "source": "arduino-hc-uno"
    }
