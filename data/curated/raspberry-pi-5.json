  "gotchas": [
    {
      "title": "A 3 A supply caps USB at 600 mA",
      "text": "With anything less than a 5 V, 5 A supply, the Pi 5 limits all downstream USB devices to 600 mA combined. Use the 27 W supply for USB drives.",
      "source": "rpi-power"
    },
    {
      "title": "GPIO moved to the RP1 chip",
      "text": "Libraries that poke the old Broadcom GPIO registers, such as RPi.GPIO, do not work on the Pi 5; use gpiozero (with its lgpio backend) or libgpiod.",
      "source": "gpiozero-pins"
    },
    {
      "title": "Cooling for heavy loads",
      "text": "It handles typical desktop use without active cooling but can throttle under continuous heavy load; the Active Cooler or the official case fan prevents that.",
      "source": "pi5-launch"
    },
    {
      "title": "3.3 V only",
      "text": "The GPIO pins are 3.3 V. Do not connect 5 V signals or components to them.",
      "source": "rpi-gpio"
    },
    {
      "title": "Little current per pin",
      "text": "Each GPIO pin can supply up to about 16 mA and all pins together about 50 mA; drive motors and other loads through a transistor or driver board.",
      "source": "rpi-power"
    }
  ],
