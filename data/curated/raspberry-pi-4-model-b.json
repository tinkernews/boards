  "gotchas": [
    {
      "title": "Use a 3 A USB-C supply",
      "text": "Raspberry Pi recommends its 5 V, 3 A USB-C supply; a weak supply or a thin cable triggers undervoltage warnings.",
      "source": "rpi-power"
    },
    {
      "title": "It runs warm",
      "text": "The BCM2711 throttles progressively under sustained load as it heats up; a heatsink or the official case fan reduces throttling.",
      "source": "rpi-frequency"
    },
    {
      "title": "Micro-HDMI, not HDMI",
      "text": "Both video outputs are micro-HDMI; you need adapters or micro-HDMI cables.",
      "source": "rpi-docs-source"
    },
    {
      "title": "3.3 V only",
      "text": "The GPIO pins are 3.3 V. Do not connect 5 V signals or components to them.",
      "source": "rpi-gpio"
    },
    {
      "title": "Little current per pin",
      "text": "Each GPIO pin can supply up to about 16 mA and all pins together about 50 mA; drive motors and other loads through a transistor or driver board.",
