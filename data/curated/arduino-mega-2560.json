  "gotchas": [
    {
      "title": "I2C and SPI are on different pins",
      "text": "SPI is on pins 50–53 (and the ICSP header), not D10–D13 as on the Uno, so Uno shields that use SPI on D10–D13 need rewiring; I2C is on pins 20 and 21.",
      "source": "arduino-pinout"
    },
    {
      "title": "5 V logic",
      "text": "I/O is 5 V. Sensors and modules that run at 3.3 V (most modern ones) need level shifting on their inputs.",
      "source": "arduino-docs"
    }
  ],
